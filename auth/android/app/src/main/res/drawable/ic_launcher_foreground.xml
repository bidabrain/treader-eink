<?xml version="1.0" encoding="utf-8"?>
<!-- 固件 TR_ICON_KEY 的钥匙（tr_ui.c）：左边圆环（圆心 12,20、半径 7），钥匙杆从 19 到 36，两个齿在 30、35。坐标照抄
     固件的 40 格，线宽 3，整体放大 1.4 倍、移到 108 画布中心，落在自适应图标的安全区里。
     The firmware TR_ICON_KEY key (tr_ui.c): a ring on the left (center 12,20, radius 7), the shaft from 19 to 36 and
     two teeth at 30 and 35. Coordinates are the firmware's 40-unit grid with 3-unit strokes, scaled 1.4x and centered
     on the 108 canvas, inside the adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 钥匙外框 x 3.5..37.5、y 11.5..28.5，中心 (20.5, 20)。/ The key spans x 3.5..37.5, y 11.5..28.5, centered at
         (20.5, 20). -->
    <group
        android:scaleX="1.4"
        android:scaleY="1.4"
        android:translateX="25.3"
        android:translateY="26">
        <!-- 圆环 / Ring -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3"
            android:fillColor="#00000000"
            android:pathData="M5,20 A7,7 0 1,1 19,20 A7,7 0 1,1 5,20 Z" />
        <!-- 钥匙杆和两个齿 / Shaft and two teeth -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3"
            android:strokeLineCap="square"
            android:fillColor="#00000000"
            android:pathData="M19,20 L36,20 M30,20 L30,27 M35,20 L35,26" />
    </group>
</vector>
