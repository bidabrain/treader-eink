# 复制成 .env 再改。/ Copy to .env and edit.

# 面板和设备接口的端口；只想本机访问就把 BIND 改成 127.0.0.1。
# Port for the panel and device API; set BIND to 127.0.0.1 for local-only access.
REDNOTE_BIND=0.0.0.0
REDNOTE_PORT=8091

# xiaohongshu-mcp 版本。/ xiaohongshu-mcp version.
MCP_VERSION=v2.7.4

# 服务器出口不在国内时，可以给浏览器配一个国内出口的代理（http/https/socks5）。
# If the server's exit is outside mainland China, give the browser a mainland proxy (http/https/socks5).
XHS_PROXY=
