<?xml version="1.0" encoding="utf-8"?>
<!-- 固件 TR_ICON_X 的小鸟（tr_ui.c）：圆身子、圆头、尖嘴、上扬的翅膀、短尾巴，全部黑色实心。坐标照抄固件的 40 格，
     整体放大 1.4 倍、移到 108 画布中心，落在自适应图标的安全区里（以 54,54 为圆心、半径 33）。
     The firmware TR_ICON_X bird (tr_ui.c): round body and head, pointed beak, raised wing and short tail, all solid
     black. Coordinates are the firmware's 40-unit grid, scaled 1.4x and centered on the 108 canvas, inside the
     adaptive-icon safe zone (radius 33 around 54,54). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 鸟的外框 x 2..39、y 9..34，中心 (20.5, 21.5)。/ The bird spans x 2..39, y 9..34, centered at (20.5, 21.5). -->
    <group
        android:scaleX="1.4"
        android:scaleY="1.4"
        android:translateX="25.3"
        android:translateY="23.9">
        <!-- 身子 / Body -->
        <path
            android:fillColor="#000000"
            android:pathData="M8,24 A10,10 0 1,1 28,24 A10,10 0 1,1 8,24 Z" />
        <!-- 头 / Head -->
        <path
            android:fillColor="#000000"
            android:pathData="M22,15 A6,6 0 1,1 34,15 A6,6 0 1,1 22,15 Z" />
        <!-- 嘴 / Beak -->
        <path
            android:fillColor="#000000"
            android:pathData="M33,12 L39,13 L33,17 Z" />
        <!-- 翅膀 / Wing -->
        <path
            android:fillColor="#000000"
            android:pathData="M9,21 L23,18 L4,9 Z" />
        <!-- 尾巴 / Tail -->
        <path
            android:fillColor="#000000"
            android:pathData="M10,27 L2,31 L13,33 Z" />
    </group>
</vector>
