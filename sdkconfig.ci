# CI 只验证代码能编过，不追求真机上的性能配置。
# 120MHz flash + PSRAM、HPM 和温度补偿都依赖具体的 flash 型号（本机 Zbit 0x5E），
# 在容器里既测不出来也没必要，所以这里退回到默认时序，其余保持和真机一致。
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16M.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
# 与产品的 PNG 解码栈预算一致。/ Match the product PNG decoding stack budget.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
# 长文件名 API 与产品配置一致，保证中文路径按 UTF-8 往返。
# Match the product filename API so Chinese paths round-trip as UTF-8.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
# 大文件（几百页的 CBZ、字体）里来回跳读：给只读打开的文件记一张簇位置表，不用每次从文件头顺着 FAT 链数；
# 256 字能记 127 段，边下边写、碎成很多段的文件也够用（每个打开的文件约 1 KB）。
# Seeking around large files (CBZ with hundreds of pages, fonts): keep a cluster map for read-only files instead of
# walking the FAT chain from the start each time; 256 words hold 127 fragments, enough for files written piecemeal
# while downloading (about 1 KB per open file).
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=256

# 传书热点；优先把网络缓冲放PSRAM，避免占用显示所需内部内存。
# Transfer AP prefers PSRAM network buffers, preserving internal display memory.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024
# Treader：TF 卡升级后新固件起不来就退回旧版本。/ Roll back to the previous app if a TF-upgraded one fails to boot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 证书包支持交叉签名：Cloudflare 等站点发的链以“被 GlobalSign Root CA 交叉签名的 GTS Root R4”结尾，
# 证书包里只有 GTS Root R4，不开这项握手会失败（约多用 700 字节堆）。
# Cross-signed chains: Cloudflare-style chains end in GTS Root R4 cross-signed by GlobalSign Root CA, which the
# bundle lacks; without this the handshake fails (~700 bytes of heap).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# USB 传书：TinyUSB U 盘（和 sdkconfig.defaults 一致）。/ USB transfer: TinyUSB mass storage (same as sdkconfig.defaults).
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Treader"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Read Pico"
CONFIG_TINYUSB_DESC_MSC_STRING="Read Pico TF"
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y
