# 复制成 .env 再改。/ Copy to .env and edit.

# 面板和设备接口的端口；只想本机访问就把 BIND 改成 127.0.0.1。
# Port for the panel and device API; set BIND to 127.0.0.1 for local-only access.
TOMATO_BIND=0.0.0.0
TOMATO_PORT=18423

# 官方下载器镜像的版本（升级前先在面板里试一轮）。/ Official downloader image version (try it in the panel before upgrading).
DOWNLOADER_VERSION=v2.4.18-musl
