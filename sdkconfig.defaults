CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16M.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# 实验性组合：MSPI 的 flash 与 PSRAM 共用时钟域，CPU 240MHz 下 IDF 只标定了
# 模块时钟 120MHz，所以 PSRAM 想上 120MHz，flash 必须一起 120MHz。
# 渲染线程逐行读 PSRAM 里的 framebuffer，80MHz 时的实效带宽（约 32MB/s）
# 就是刷新速度的天花板。flash 侧靠 main/flash_hpm_zb.c 补上本机型号的高性能模式。
# 已知风险：上电后温度漂移约 20℃ 会让 PSRAM 访问随机出错。IDF 的温度补偿
# （SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR）只对 flash vendor
# 0xC8/0x20 验证过，本机是 ZB25VQ128(Zbit)，开了会在 do_system_init_fn 里报
# 「flash model has not been verified」直接 abort 并循环重启，所以必须关掉，
# 等于没有这层保护。别改成 y。
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
# 显式启用 HPM（AUTO 会因为"依赖具体 flash 型号"报 #warning，-Werror 下编不过）。
# 本机 flash 靠写状态寄存器进入高性能模式，不需要调 dummy cycle，所以关掉 HPM-DC。
CONFIG_SPI_FLASH_HPM_ENA=y
CONFIG_SPI_FLASH_HPM_DC_DISABLE=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# 渲染线程逐行流式读 PSRAM 里的 framebuffer，cache 越大预取越不容易失效
CONFIG_ESP32S3_DATA_CACHE_64KB=y
# PNG 解码的有界局部缓冲需要额外栈空间。/ Bounded PNG decoder locals need additional stack space.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 1ms tick：EPD 上电流程里按毫秒轮询 PGOOD，100Hz 的 tick 会把每次等待放大到 10ms
CONFIG_FREERTOS_HZ=1000
# 长文件名以 UTF-8 交给界面与 fopen；磁盘 LFN 保持 UTF-16，不需要增加 CP936 表。
# Pass long filenames to UI and fopen as UTF-8; on-disk LFN stays UTF-16 without a CP936 table.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
# 大文件（几百页的 CBZ、字体）里来回跳读：给只读打开的文件记一张簇位置表，不用每次从文件头顺着 FAT 链数；
# 256 字能记 127 段，边下边写、碎成很多段的文件也够用（每个打开的文件约 1 KB）。
# Seeking around large files (CBZ with hundreds of pages, fonts): keep a cluster map for read-only files instead of
# walking the FAT chain from the start each time; 256 words hold 127 fragments, enough for files written piecemeal
# while downloading (about 1 KB per open file).
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=256

# 传书热点；优先把网络缓冲放PSRAM，避免占用显示所需内部内存。
# Transfer AP prefers PSRAM network buffers, preserving internal display memory.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# TCP 接收窗口从默认 5760（4 个包）加到 32 KB：经 Cloudflare 这种往返长的线路，下载速度约等于窗口除以往返时间，
# 默认窗口只有几十 KB/s。收包缓冲在 PSRAM（上面一行），不占内部内存。
# TCP receive window raised from the default 5760 (four segments) to 32 KB: over long round trips such as Cloudflare,
# download speed is about window / round trip, only tens of KB/s with the default. The buffers live in PSRAM (above),
# not internal memory.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# Treader：允许把大的静态数组放进 PSRAM（EXT_RAM_BSS_ATTR），给 Wi-Fi 和 TLS 留出内部 RAM。
# Treader: allow large static arrays in PSRAM (EXT_RAM_BSS_ATTR) to keep internal RAM for Wi-Fi and TLS.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Treader：TF 卡升级后新固件起不来就退回旧版本。/ Roll back to the previous app if a TF-upgraded one fails to boot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 证书包支持交叉签名：Cloudflare 等站点发的链以“被 GlobalSign Root CA 交叉签名的 GTS Root R4”结尾，
# 证书包里只有 GTS Root R4，不开这项握手会失败（约多用 700 字节堆）。
# Cross-signed chains: Cloudflare-style chains end in GTS Root R4 cross-signed by GlobalSign Root CA, which the
# bundle lacks; without this the handshake fails (~700 bytes of heap).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# mbedTLS / PSA 全部从 PSRAM 分配：内部 RAM 碎片化后验 RSA-4096 签名会报 PSA -141（内存不足），
# 表现为“HTTPS 握手失败”，ECC 证书的站点（GitHub）却能连。
# Allocate all mbedTLS / PSA memory from PSRAM: with fragmented internal RAM, RSA-4096 signature checks fail with
# PSA -141 (insufficient memory) and show as "HTTPS handshake failed", while ECC sites (GitHub) still connect.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# TLS 会话复用：同一个服务器重连时走简化握手，省掉证书验证和密钥交换（新建连接实测 7～17 秒）。
# TLS session resumption: reconnecting to the same server takes the short handshake, skipping certificate checks and
# key exchange (new connections measured at 7-17 s).
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
# 椭圆曲线定点运算用预计算表，ECDHE / ECDSA 快几倍；表在 PSRAM 里，多占的内存不碍事。
# Precomputed tables for fixed-point ECC make ECDHE / ECDSA several times faster; the tables live in PSRAM.
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
# TCP 选择性确认：手机热点上丢包多，收到乱序的包时告诉对方缺哪段，只补那段，不用干等超时重传（实测图片常传到一半停十几秒）。
# TCP selective acknowledgements: phone hotspots drop packets often; reporting which part is missing lets the sender
# resend just that instead of waiting for a retransmit timeout (images were seen stalling midway for 15 s and more).
CONFIG_LWIP_TCP_SACK_OUT=y

# USB 传书：TinyUSB U 盘。/ USB transfer: TinyUSB mass storage.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Treader"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Read Pico"
CONFIG_TINYUSB_DESC_MSC_STRING="Read Pico TF"
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y
